# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID shown after you register the webhook (npm run webhook:register -- https://your-host)
PAYPAL_WEBHOOK_ID=

# Photo counting. Leave GEMINI_API_KEY empty to count by hand or replay recorded results.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# gemini | replay | manual
VISION_PROVIDER=gemini

# Public URL of this app (used for the booth QR code). Defaults to the request host.
PUBLIC_BASE_URL=
# SQLite file location
HALFTIME_DB=./data/halftime.db
